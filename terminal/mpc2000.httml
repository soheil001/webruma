<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Webruma MPC 2000XL</title>
<style>
:root{color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0;background:#04060b}
body{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:12px 0 20px;font-family:Tahoma,"Segoe UI",Arial,sans-serif;color:#9fb6cf}
.stage{position:relative;width:min(100vw,1297px);aspect-ratio:1297/1213;user-select:none;-webkit-user-select:none;direction:ltr;--p:1px}
#bg{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none}

/* ---------- hotspots ---------- */
.hs{position:absolute;margin:0;padding:0;border:0;background:transparent;cursor:pointer;border-radius:calc(5*var(--p));touch-action:none;-webkit-tap-highlight-color:transparent;outline:none;z-index:5}
.hs::after{content:"";position:absolute;inset:0;border-radius:inherit;opacity:0;transition:opacity .35s ease-out;pointer-events:none;mix-blend-mode:screen;
  background:radial-gradient(ellipse at 50% 50%,rgba(150,225,255,.75),rgba(40,150,255,.45) 65%,rgba(0,100,255,.15));
  box-shadow:0 0 calc(14*var(--p)) rgba(60,180,255,.85)}
.hs.down::after,.hs.flash::after,.hs.on::after{opacity:1;transition:none}
.hs.on:not(.down)::after{opacity:.8}
.hs.red::after{background:radial-gradient(ellipse at 50% 50%,rgba(255,150,120,.8),rgba(255,50,30,.5) 65%,rgba(255,0,0,.15));box-shadow:0 0 calc(16*var(--p)) rgba(255,70,40,.9)}
.hs.org::after{background:radial-gradient(ellipse at 50% 50%,rgba(255,220,150,.8),rgba(255,140,20,.5) 65%,rgba(255,100,0,.15));box-shadow:0 0 calc(14*var(--p)) rgba(255,150,30,.9)}
.hs.pad{border-radius:calc(6*var(--p))}
.hs.pad::after{background:radial-gradient(ellipse at 50% 50%,rgba(170,235,255,.9),rgba(40,160,255,.55) 55%,rgba(0,110,255,.2) 85%);box-shadow:0 0 calc(30*var(--p)) rgba(40,170,255,.95)}
.hs.round{border-radius:50%}
.hs.round::after{display:none}
.hs:focus-visible{outline:2px solid #6fe0ff;outline-offset:1px}
.disc{position:absolute;border-radius:50%;background-image:var(--img);background-repeat:no-repeat;pointer-events:none;will-change:transform;z-index:3}
.fmark{position:absolute;left:calc(68*var(--p));width:calc(74*var(--p));height:calc(3*var(--p));background:#d4f1ff;border-radius:2px;box-shadow:0 0 calc(10*var(--p)) #38c0ff,0 0 calc(3*var(--p)) #fff;display:none;pointer-events:none;z-index:4}

/* ---------- LCD ---------- */
.lcd{position:absolute;left:calc(160*var(--p));top:calc(103*var(--p));width:calc(408*var(--p));height:calc(120*var(--p));overflow:hidden;border-radius:calc(4*var(--p));z-index:2;
  background:radial-gradient(ellipse at 50% 40%,#02408f 0%,#012a73 55%,#001b5a 100%);
  color:#7fdcff;font:600 calc(13*var(--p))/1 "Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;letter-spacing:.02em;
  text-shadow:0 0 calc(5*var(--p)) rgba(40,170,255,.9);box-shadow:inset 0 0 calc(18*var(--p)) rgba(0,150,255,.35);pointer-events:none;transition:filter .2s}
.lcd.alt{filter:brightness(1.3) contrast(1.15)}
.lcd>*{position:absolute}
.lcd .ln{background:rgba(90,205,255,.85);box-shadow:0 0 4px rgba(60,180,255,.8)}
.lcd .h1{left:calc(11*var(--p));top:calc(4*var(--p));line-height:calc(14*var(--p));white-space:nowrap}
.lcd .h2{left:calc(198*var(--p));top:calc(4*var(--p));line-height:calc(14*var(--p));transform:translateX(-50%);white-space:nowrap}
.lcd .h3{left:calc(291*var(--p));top:calc(4*var(--p));line-height:calc(14*var(--p));white-space:nowrap}
.lcd canvas{display:block}
#lMeter{left:calc(357*var(--p));top:calc(5*var(--p));width:calc(43*var(--p));height:calc(11*var(--p))}
#lWave{left:calc(100*var(--p));top:calc(24*var(--p));width:calc(208*var(--p));height:calc(66*var(--p))}
.list,.info{top:calc(25*var(--p));height:calc(66*var(--p))}
.list{left:0;width:calc(98*var(--p))}
.info{left:calc(318*var(--p));width:calc(88*var(--p))}
.r{position:relative;height:calc(16.3*var(--p));line-height:calc(16.3*var(--p));white-space:nowrap}
.r i{position:absolute;left:calc(11*var(--p));font-style:normal}
.r b{position:absolute;left:calc(43*var(--p));font-weight:600}
.r span{position:absolute;left:0}
.r.on{color:#fff;text-shadow:0 0 calc(6*var(--p)) #5cd6ff,0 0 calc(12*var(--p)) #1aa9ff}
.keys{left:0;top:calc(96*var(--p));width:100%;height:calc(22*var(--p))}
.k{position:absolute;top:0;width:calc(73*var(--p));height:calc(22*var(--p));line-height:calc(21*var(--p));text-align:center;border:1px solid rgba(70,195,255,.95);border-radius:calc(3*var(--p));background:rgba(0,110,230,.18);box-shadow:inset 0 0 calc(6*var(--p)) rgba(40,170,255,.35)}
.k.on{background:rgba(80,205,255,.4);color:#fff;text-shadow:0 0 calc(7*var(--p)) #8fe5ff}
.toast{left:50%;top:50%;transform:translate(-50%,-50%);padding:calc(6*var(--p)) calc(16*var(--p));border:1px solid #7be4ff;background:rgba(0,26,84,.97);color:#fff;border-radius:calc(4*var(--p));display:none;z-index:4;white-space:nowrap;box-shadow:0 0 calc(14*var(--p)) rgba(50,170,255,.7)}
.win{left:calc(30*var(--p));top:calc(24*var(--p));width:calc(348*var(--p));height:calc(68*var(--p));border:1px solid #7be4ff;background:rgba(0,24,80,.98);display:none;z-index:3;border-radius:calc(3*var(--p));padding:calc(4*var(--p)) calc(10*var(--p))}
.win .r{height:calc(15.5*var(--p));line-height:calc(15.5*var(--p))}
.win .r span{left:0}
.win .r em{position:absolute;left:calc(170*var(--p));font-style:normal}

.hint{width:min(96vw,1000px);text-align:center;font-size:13px;line-height:1.9;color:#7e93ab}
.hint kbd{font:600 12px ui-monospace,Consolas,monospace;background:#0e1623;border:1px solid #243247;border-radius:4px;padding:1px 6px;color:#bfe6ff;direction:ltr;display:inline-block}
</style>
</head>
<body>

<div class="stage" id="stage">
  <img id="bg" alt="Webruma MPC 2000XL" draggable="false" src="data:image/webp;base64,">
  <div class="lcd" id="lcd">
    <div class="h1">PROJECT : WEBRUMA</div>
    <div class="h2" id="lPos">001: 01.00</div>
    <div class="h3">BPM <span id="lBpm">92.0</span></div>
    <canvas id="lMeter"></canvas>
    <div class="ln" style="left:calc(3*var(--p));right:calc(3*var(--p));top:calc(21*var(--p));height:1px"></div>
    <div class="ln" style="left:calc(98*var(--p));top:calc(23*var(--p));width:1px;height:calc(68*var(--p))"></div>
    <div class="ln" style="left:calc(309*var(--p));top:calc(23*var(--p));width:1px;height:calc(68*var(--p))"></div>
    <div class="ln" style="left:calc(3*var(--p));right:calc(3*var(--p));top:calc(92*var(--p));height:1px;opacity:.7"></div>
    <div class="list" id="lList"></div>
    <canvas id="lWave"></canvas>
    <div class="info" id="lInfo"></div>
    <div class="keys" id="lKeys"></div>
    <div class="win" id="lWin"></div>
    <div class="toast" id="lToast"></div>
  </div>
</div>

<div class="hint">
  کلیدهای کیبورد: پدها <kbd>Z X C V</kbd> = پد ۱–۴ ، <kbd>A S D F</kbd> = پد ۵–۸ ، <kbd>Q W E R</kbd> = پد ۹–۱۲ ، <kbd>1 2 3 4</kbd> = پد ۱۳–۱۶ ·
  <kbd>Space</kbd> پلی/استاپ · <kbd>Enter</kbd> ریکورد<br>
  ولوم‌ها و چرخ DATA را با درگ (یا اسکرول ماوس) بچرخانید · فیدر سمت چپ را بکشید
</div>

<script>
(()=>{
const W=1297;
const $=s=>document.querySelector(s);
const stage=$('#stage'), bg=$('#bg'), lcd=$('#lcd');
const pad2=(n,l=2)=>String(n).padStart(l,'0');
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));

/* image is embedded as a data: URI in the <img> tag */
stage.style.setProperty('--img','url("'+bg.getAttribute('src')+'")');
function fit(){
  const p=stage.clientWidth/W;
  stage.style.setProperty('--p',p+'px');
  sizeCanvases();
}

/* ---------- state ---------- */
const NAMES=['Kick','Snare','HiHat','Loop','Clap','Rim','Tom Lo','Tom Hi','Open HH','Cowbell','Crash','Perc','Bass','Chord','Lead','FX'];
const BANK_SEMI={A:0,B:3,C:-5,D:7};
const S={bpm:92,bank:'A',sel:1,hl:3,page:'SAMPLE',prow:0,playing:false,rec:false,od:false,full:false,lv16:false,mute:false,seq:1,
  nr:false,after:false,shift:false,eq:false,comp:false,fx:false,win:false,alt:false,rg:.5,vol:.5,ftune:0,touched:false};
const padTune=new Array(16).fill(0), padLevel=new Array(16).fill(100), padStart=new Array(16).fill(0), padEnd=new Array(16).fill(100);
const seqs={1:[],2:[]};
const LEN=32;

/* ---------- audio ---------- */
let ac,master,eqL,eqH,comp,outG,analyser,dly,dlySend,noiseBuf;
function initAudio(){
  if(ac){ if(ac.state==='suspended')ac.resume(); return; }
  ac=new (window.AudioContext||window.webkitAudioContext)();
  outG=ac.createGain(); outG.gain.value=S.vol*1.4;
  comp=ac.createDynamicsCompressor();
  eqL=ac.createBiquadFilter(); eqL.type='lowshelf'; eqL.frequency.value=120;
  eqH=ac.createBiquadFilter(); eqH.type='highshelf'; eqH.frequency.value=6000;
  master=ac.createGain(); master.gain.value=.8;
  dly=ac.createDelay(1); dly.delayTime.value=.27;
  const fb=ac.createGain(); fb.gain.value=.38; dly.connect(fb); fb.connect(dly);
  dlySend=ac.createGain(); dlySend.gain.value=0; dlySend.connect(dly); dly.connect(master);
  master.connect(eqL); eqL.connect(eqH); eqH.connect(comp); comp.connect(outG); outG.connect(ac.destination);
  analyser=ac.createAnalyser(); analyser.fftSize=1024; outG.connect(analyser);
  noiseBuf=ac.createBuffer(1,ac.sampleRate*2,ac.sampleRate);
  const d=noiseBuf.getChannelData(0); for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;
  applyFx();
}
function applyFx(){
  if(!ac)return;
  eqL.gain.value=S.eq?6:0; eqH.gain.value=S.eq?4:0;
  comp.threshold.value=S.comp?-28:0; comp.ratio.value=S.comp?8:1;
  dlySend.gain.value=S.fx?.35:0;
}
function env(t,peak,dur){
  const g=ac.createGain(); g.gain.setValueAtTime(.0001,t);
  g.gain.exponentialRampToValueAtTime(Math.max(peak,.0002),t+.004);
  g.gain.exponentialRampToValueAtTime(.0001,t+dur);
  g.connect(master); g.connect(dlySend); return g;
}
function tone({type='sine',f0,f1,dur=.3,peak=.5,t,sw,lp}){
  f1=f1||f0; sw=sw||dur*.4;
  const o=ac.createOscillator(); o.type=type; o.frequency.setValueAtTime(f0,t);
  if(f1!==f0)o.frequency.exponentialRampToValueAtTime(f1,t+sw);
  const g=env(t,peak,dur); let n=o;
  if(lp){const f=ac.createBiquadFilter();f.type='lowpass';f.frequency.value=lp;o.connect(f);n=f;}
  n.connect(g); o.start(t); o.stop(t+dur+.05);
}
function nz({dur=.2,peak=.5,t,type='highpass',f=5000,fEnd,q=1}){
  const s=ac.createBufferSource(); s.buffer=noiseBuf; s.loop=true;
  const fl=ac.createBiquadFilter(); fl.type=type; fl.frequency.setValueAtTime(f,t); fl.Q.value=q;
  if(fEnd)fl.frequency.exponentialRampToValueAtTime(fEnd,t+dur);
  const g=env(t,peak,dur); s.connect(fl); fl.connect(g); s.start(t,Math.random()); s.stop(t+dur+.05);
}
const VOICES=[
 (t,v,k)=>tone({f0:160*k,f1:42*k,dur:.5,peak:v,t,sw:.12}),
 (t,v,k)=>{nz({dur:.22,peak:.7*v,t,type:'bandpass',f:1900*k,q:.8});tone({type:'triangle',f0:210*k,f1:150*k,dur:.14,peak:.5*v,t,sw:.05});},
 (t,v,k)=>nz({dur:.06,peak:.35*v,t,f:7000*k}),
 (t,v,k)=>[0,3,7,12].forEach((s,i)=>tone({type:'square',f0:330*k*Math.pow(2,s/12),dur:.09,peak:.2*v,t:t+i*.1,lp:2600})),
 (t,v,k)=>{[0,.011,.023].forEach((o,i)=>nz({dur:i<2?.02:.2,peak:.55*v,t:t+o,type:'bandpass',f:1300*k,q:1.2}));},
 (t,v,k)=>{tone({type:'square',f0:820*k,dur:.05,peak:.3*v,t,lp:4000});nz({dur:.03,peak:.4*v,t,type:'bandpass',f:3000,q:2});},
 (t,v,k)=>tone({f0:130*k,f1:75*k,dur:.4,peak:.9*v,t,sw:.2}),
 (t,v,k)=>tone({f0:220*k,f1:120*k,dur:.3,peak:.85*v,t,sw:.15}),
 (t,v,k)=>nz({dur:.4,peak:.3*v,t,f:6500*k}),
 (t,v,k)=>{[560,845].forEach(f=>tone({type:'square',f0:f*k,dur:.35,peak:.14*v,t,lp:2500}));},
 (t,v,k)=>nz({dur:1.4,peak:.38*v,t,f:4500*k}),
 (t,v,k)=>tone({f0:1000*k,f1:420*k,dur:.12,peak:.5*v,t,sw:.08}),
 (t,v,k)=>tone({type:'sawtooth',f0:55*k,dur:.45,peak:.6*v,t,lp:500}),
 (t,v,k)=>[261.6,311.1,392].forEach(f=>tone({type:'sawtooth',f0:f*k,dur:.7,peak:.15*v,t,lp:1600})),
 (t,v,k)=>tone({type:'square',f0:523*k,dur:.45,peak:.22*v,t,lp:3000}),
 (t,v,k)=>nz({dur:.6,peak:.35*v,t,type:'bandpass',f:300,fEnd:5000,q:3})
];
function playVoice(n,v,t){
  if(!ac)return;
  const semi=BANK_SEMI[S.bank]+padTune[n-1]+S.ftune, k=Math.pow(2,semi/12);
  VOICES[n-1](t||ac.currentTime,clamp(v*padLevel[n-1]/100,0,1.3),k);
  S.touched=true; startSweep();
}
function click(t,acc){ if(ac)tone({f0:acc?2000:1400,dur:.03,peak:.12,t}); }

/* ---------- hotspots ---------- */
const H={};
function place(el,x,y,w,h){
  el.style.left=`calc(${x}*var(--p))`; el.style.top=`calc(${y}*var(--p))`;
  el.style.width=`calc(${w}*var(--p))`; el.style.height=`calc(${h}*var(--p))`;
}
function mk(id,cx,cy,w,h,cls,label){
  const b=document.createElement('button'); b.type='button';
  b.className='hs'+(cls?' '+cls:''); b.dataset.id=id; b.setAttribute('aria-label',label||id);
  place(b,cx-w/2,cy-h/2,w,h); stage.appendChild(b); H[id]=b; return b;
}
function bind(el,h){
  el.addEventListener('pointerdown',e=>{
    e.preventDefault(); try{el.setPointerCapture(e.pointerId)}catch(_){}
    el.classList.add('down'); initAudio(); h.down&&h.down(e,el);
  });
  el.addEventListener('pointermove',e=>{ if(el.classList.contains('down'))h.move&&h.move(e,el); });
  const up=e=>{ if(!el.classList.contains('down'))return; el.classList.remove('down'); h.up&&h.up(e,el); };
  el.addEventListener('pointerup',up); el.addEventListener('pointercancel',up);
  el.addEventListener('keydown',e=>{ if((e.key==='Enter'||e.key===' ')&&!e.repeat){e.preventDefault();e.stopPropagation();el.classList.add('down');initAudio();h.down&&h.down(null,el);} });
  el.addEventListener('keyup',e=>{ if(e.key==='Enter'||e.key===' '){ if(el.classList.contains('down')){el.classList.remove('down');h.up&&h.up(null,el);} } });
}
const setOn=(id,v)=>H[id]&&H[id].classList.toggle('on',!!v);
function flash(id,ms=110){ const el=H[id]; if(!el)return; el.classList.add('flash'); setTimeout(()=>el.classList.remove('flash'),ms); }
const btn=(id,cx,cy,w,h,fn,cls,label)=>{ const e=mk(id,cx,cy,w,h,cls,label); bind(e,{down:fn}); return e; };

/* ---------- LCD ---------- */
const PAGES=['SAMPLE','EDIT','PROGRAM','MIX','FX'];
const KX=[10,91,171,253,333];
$('#lKeys').innerHTML=PAGES.map((p,i)=>`<div class="k" style="left:calc(${KX[i]}*var(--p))" data-p="${p}">${p}</div>`).join('');
let toastT;
function toast(msg,ms=1100){
  const t=$('#lToast'); t.textContent=msg; t.style.display='block';
  clearTimeout(toastT); toastT=setTimeout(()=>t.style.display='none',ms);
}
const R=(a,hl)=>a.map((t,i)=>`<div class="r${i===hl?' on':''}">${t}</div>`).join('');
const tuneStr=v=>(v>=0?'+':'')+v.toFixed(1);
function renderLCD(){
  $('#lBpm').textContent=S.bpm.toFixed(1);
  document.querySelectorAll('#lKeys .k').forEach(k=>k.classList.toggle('on',k.dataset.p===S.page));
  const w4=Math.floor((S.sel-1)/4)*4, pn=pad2(S.sel);
  let list,info,hl;
  const padRows=()=>[0,1,2,3].map(i=>`<i>${pad2(w4+i+1)}</i><b>${NAMES[w4+i]}</b>`);
  if(S.page==='SAMPLE'){
    list=padRows(); hl=S.hl;
    info=[`PAD ${pn} ▶`,'STEREO','16 bit','44.1 kHz'].map(t=>`<span>${t}</span>`);
  }else if(S.page==='EDIT'){
    list=['Start','End','Tune','Level'].map((n,i)=>`<i>${pad2(i+1)}</i><b>${n}</b>`); hl=S.prow;
    const vals=[pad2(padStart[S.sel-1],3),pad2(padEnd[S.sel-1],3),tuneStr(padTune[S.sel-1]),pad2(padLevel[S.sel-1],3)];
    info=[`PAD ${pn} ▶`,['START','END','TUNE','LEVEL'][S.prow],vals[S.prow],`BANK ${S.bank}`].map(t=>`<span>${t}</span>`);
  }else if(S.page==='PROGRAM'){
    list=padRows(); hl=S.hl;
    info=[`PAD ${pn}`,`LVL ${pad2(padLevel[S.sel-1],3)}`,`TUN ${tuneStr(padTune[S.sel-1])}`,`BANK ${S.bank}`].map(t=>`<span>${t}</span>`);
  }else if(S.page==='MIX'){
    list=['Rec','Vol','Tune','Tempo'].map((n,i)=>`<i>${pad2(i+1)}</i><b>${n}</b>`); hl=S.prow;
    const v=[Math.round(S.rg*100),Math.round(S.vol*100),tuneStr(S.ftune),S.bpm.toFixed(1)];
    info=['MIX',['REC GAIN','MAIN VOL','TUNE','TEMPO'][S.prow],String(v[S.prow]),`SEQ ${pad2(S.seq)}`].map(t=>`<span>${t}</span>`);
  }else{
    list=['Effects','EQ','Comp','Delay'].map((n,i)=>`<i>${pad2(i+1)}</i><b>${n}</b>`); hl=S.prow;
    const st=[S.fx,S.eq,S.comp,S.fx];
    info=['FX',['EFFECTS','EQ','EQ COMP','DELAY'][S.prow],(S.prow===3?(S.fx?'270 ms':'OFF'):(st[S.prow]?'ON':'OFF')),`BANK ${S.bank}`].map(t=>`<span>${t}</span>`);
  }
  $('#lList').innerHTML=R(list,hl);
  $('#lInfo').innerHTML=R(info,-1);
  const win=$('#lWin');
  if(S.win){
    win.style.display='block';
    win.innerHTML=[['SEQUENCE',pad2(S.seq)+'  ·  '+(S.mute?'MUTED':'ACTIVE')],['PAD / BANK',pn+'  ·  '+S.bank],['EQ / COMP / FX',(S.eq?'ON':'OFF')+' / '+(S.comp?'ON':'OFF')+' / '+(S.fx?'ON':'OFF')],['NOTE REPEAT',S.nr?'ON':'OFF']]
      .map(r=>`<div class="r"><span>${r[0]}</span><em>${r[1]}</em></div>`).join('');
  }else win.style.display='none';
}
let dispStep=0;
function refreshPos(){
  const s=dispStep, bar=Math.floor(s/16)+1, beat=Math.floor((s%16)/4)+1, tick=(s%4)*24;
  $('#lPos').textContent=`${pad2(bar,3)}: ${pad2(beat)}.${pad2(tick)}`;
}
const page=(p)=>{S.page=p;S.prow=0;renderLCD();};

/* ---------- LCD canvases ---------- */
const cvW=$('#lWave'), cxW=cvW.getContext('2d'), cvM=$('#lMeter'), cxM=cvM.getContext('2d');
function sizeCanvases(){
  const p=stage.clientWidth/W, dpr=window.devicePixelRatio||1;
  [[cvW,208,66],[cvM,43,11]].forEach(([c,w,h])=>{c.width=Math.max(1,Math.round(w*p*dpr));c.height=Math.max(1,Math.round(h*p*dpr));});
}
const wf={};
function getWf(n){
  if(wf[n])return wf[n];
  let s=n*7919+13; const r=()=>{s|=0;s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};
  const a=new Float32Array(104);
  for(let i=0;i<104;i++){const x=i/103,bell=Math.pow(Math.sin(Math.PI*x),.6);a[i]=(.1+.9*Math.pow(r(),1.8))*(.3+.7*bell);}
  return wf[n]=a;
}
let sweepT0=0; const SWEEP=650;
function startSweep(){ sweepT0=performance.now(); }
let lvl=0;
function drawLCD(){
  const now=performance.now();
  /* meter */
  cxM.setTransform(cvM.width/43,0,0,cvM.height/11,0,0); cxM.clearRect(0,0,43,11);
  let target=0;
  if(analyser){ const buf=new Uint8Array(analyser.fftSize); analyser.getByteTimeDomainData(buf); let s=0; for(let i=0;i<buf.length;i++){const v=(buf[i]-128)/128;s+=v*v;} target=Math.min(1,Math.sqrt(s/buf.length)*3.2); }
  lvl+= (target-lvl)*(target>lvl?.6:.08);
  const lit=S.touched?Math.round(lvl*14):11;
  for(let i=0;i<14;i++){ cxM.fillStyle=i<lit?(i>11?'#9fe9ff':'#3fc8ff'):'rgba(60,150,230,.28)'; cxM.fillRect(i*3.1,0,2,11); }
  /* main area */
  cxW.setTransform(cvW.width/208,0,0,cvW.height/66,0,0); cxW.clearRect(0,0,208,66);
  cxW.lineCap='round'; cxW.shadowColor='rgba(60,190,255,.9)'; cxW.shadowBlur=4;
  const line=(x1,y1,x2,y2,c,w)=>{cxW.strokeStyle=c;cxW.lineWidth=w;cxW.beginPath();cxW.moveTo(x1,y1);cxW.lineTo(x2,y2);cxW.stroke();};
  if(S.page==='SAMPLE'||S.page==='EDIT'){
    const a=getWf(S.sel), prog=clamp((now-sweepT0)/SWEEP,0,1.02), sweeping=prog<1;
    line(3,33,205,33,'rgba(90,210,255,.75)',1);
    line(3,2,6,2,'rgba(120,220,255,.9)',1.2);
    line(10,62,198,62,'rgba(90,210,255,.7)',1); line(10,59,10,65,'rgba(90,210,255,.7)',1); line(198,59,198,65,'rgba(90,210,255,.7)',1);
    for(let i=0;i<104;i++){
      const x=6+i*1.92, h=a[i]*29, passed=sweeping&&i/103<prog;
      line(x,33-h,x,33+h,passed?'#d9f6ff':(sweeping?'#2b9fe8':'#46cdff'),1.15);
    }
    if(sweeping){const px=6+prog*198; line(px,3,px,60,'rgba(255,255,255,.55)',1);}
    if(S.page==='EDIT'){
      const sx=6+padStart[S.sel-1]*1.98, ex=6+padEnd[S.sel-1]*1.98;
      cxW.shadowBlur=0; cxW.fillStyle='rgba(0,20,70,.55)'; cxW.fillRect(3,3,sx-3,56); cxW.fillRect(ex,3,205-ex,56);
      line(sx,2,sx,62,'#ffd24d',1.5); line(ex,2,ex,62,'#ffd24d',1.5);
    }
  }else if(S.page==='PROGRAM'){
    cxW.shadowBlur=2; cxW.font='600 8px "Segoe UI",Arial,sans-serif'; cxW.textAlign='center'; cxW.textBaseline='middle';
    for(let i=0;i<16;i++){
      const col=i%4, row=3-Math.floor(i/4), x=3+col*51, y=2+row*16, on=(i+1)===S.sel;
      cxW.fillStyle=on?'rgba(110,215,255,.55)':'rgba(40,140,230,.18)'; cxW.fillRect(x,y,48,14);
      cxW.strokeStyle='rgba(90,210,255,.8)'; cxW.lineWidth=.8; cxW.strokeRect(x,y,48,14);
      cxW.fillStyle=on?'#fff':'#7fdcff'; cxW.fillText(pad2(i+1)+' '+NAMES[i],x+24,y+7.5);
    }
  }else if(S.page==='MIX'){
    const v=[S.rg,S.vol,(S.ftune+12)/24,(S.bpm-30)/270], nm=['REC','VOL','TUNE','BPM'];
    cxW.shadowBlur=2; cxW.font='600 9px "Segoe UI",Arial,sans-serif'; cxW.textAlign='left'; cxW.textBaseline='middle';
    for(let i=0;i<4;i++){
      const y=3+i*16; cxW.fillStyle=i===S.prow?'#fff':'#7fdcff'; cxW.fillText(nm[i],4,y+7);
      cxW.strokeStyle='rgba(90,210,255,.8)'; cxW.lineWidth=.8; cxW.strokeRect(38,y,166,13);
      cxW.fillStyle=i===S.prow?'rgba(150,230,255,.8)':'rgba(60,180,255,.6)'; cxW.fillRect(39,y+1,164*clamp(v[i],0,1),11);
    }
  }else{
    cxW.shadowBlur=3;
    const pts=[]; for(let x=0;x<=200;x+=4){const t=x/200; let y=0; if(S.eq){y+=9*Math.exp(-Math.pow(t/.18,2))+6*Math.exp(-Math.pow((t-1)/.2,2));} if(S.comp)y*=.8; pts.push([4+x,30-y]);}
    cxW.strokeStyle='#46cdff'; cxW.lineWidth=1.6; cxW.beginPath(); pts.forEach((p,i)=>i?cxW.lineTo(p[0],p[1]):cxW.moveTo(p[0],p[1])); cxW.stroke();
    line(3,33,205,33,'rgba(90,210,255,.4)',.8);
    for(let i=0;i<7;i++){ const h=S.fx?30*Math.pow(.62,i):4; line(14+i*26,62,14+i*26,62-h,S.fx?'#8fe5ff':'rgba(90,210,255,.4)',3); }
    cxW.font='600 8px "Segoe UI",Arial,sans-serif'; cxW.fillStyle='#7fdcff'; cxW.shadowBlur=0; cxW.textAlign='left';
    cxW.fillText(`EQ ${S.eq?'ON':'OFF'}   COMP ${S.comp?'ON':'OFF'}   FX ${S.fx?'ON':'OFF'}`,6,12);
  }
  requestAnimationFrame(drawLCD);
}

/* ---------- sequencer ---------- */
let step=0,nextT=0,timer=null,lastStep={s:0,t:0},undoSnap=null,metroOn=true;
const stepDur=()=>60/S.bpm/4;
function sched(){
  while(nextT<ac.currentTime+.12){
    const s=step,t=nextT,evs=S.mute?[]:seqs[S.seq].filter(e=>e.s===s);
    evs.forEach(e=>playVoice(e.p,e.v,t));
    if(S.rec&&s%4===0&&metroOn)click(t,s%16===0);
    setTimeout(()=>{ lastStep={s,t}; dispStep=s; refreshPos(); evs.forEach(e=>{const id='pad'+e.p; flash(id);}); if(s%4===0){flash('play',60);} },Math.max(0,(t-ac.currentTime)*1000));
    nextT+=stepDur(); step=(step+1)%LEN;
  }
}
function start(fromZero){
  initAudio();
  if(S.playing){ if(fromZero){step=0;nextT=ac.currentTime+.05;} return; }
  if(fromZero)step=0; else step=dispStep;
  nextT=ac.currentTime+.05; S.playing=true;
  if(S.rec){ undoSnap=seqs[S.seq].slice(); if(!S.od)seqs[S.seq]=[]; }
  timer=setInterval(sched,25); setOn('play',true);
}
function stop(){
  if(!S.playing){ step=0;dispStep=0;refreshPos();return; }
  clearInterval(timer); S.playing=false; setOn('play',false);
}
function record(n,v){
  const frac=(ac.currentTime-lastStep.t)/stepDur();
  let s=(lastStep.s+(frac>.5?1:0))%LEN;
  seqs[S.seq]=seqs[S.seq].filter(e=>!(e.s===s&&e.p===n)); seqs[S.seq].push({s,p:n,v});
}

/* ---------- pads ---------- */
const reps={};
function hitPad(n,vel){
  initAudio();
  let nn=n,v=vel;
  if(S.lv16){nn=S.sel;v=n/16;}else{S.sel=n;S.hl=(n-1)%4;}
  playVoice(nn,v);
  if(S.rec&&S.playing)record(nn,v);
  renderLCD();
}
function padDown(n,e,el){
  let vel=1;
  if(!S.full&&e&&el){const r=el.getBoundingClientRect(); vel=clamp(1-.45*((e.clientY-r.top)/r.height),.5,1);}
  hitPad(n,vel);
  if(S.nr){ clearInterval(reps[n]); reps[n]=setInterval(()=>hitPad(n,vel*.92),stepDur()*1000); }
}
function padUp(n){ clearInterval(reps[n]); delete reps[n]; }
{
  const cols=[782,913,1043,1173], rowsY=[492,622,757,893], nums=[[13,14,15,16],[9,10,11,12],[5,6,7,8],[1,2,3,4]];
  nums.forEach((row,ri)=>row.forEach((n,ci)=>{
    const el=mk('pad'+n,cols[ci],rowsY[ri],104,98,'pad','PAD '+n);
    bind(el,{down:(e,el)=>padDown(n,e,el),up:()=>padUp(n)});
  }));
}

/* ---------- buttons ---------- */
const FX=[191,262,333,404,474,544];
FX.forEach((x,i)=>btn('f'+(i+1),x,316,46,30,()=>{
  if(i<5)page(PAGES[i]);
  else{S.alt=!S.alt;lcd.classList.toggle('alt',S.alt);setOn('f6',S.alt);toast(S.alt?'CONTRAST HIGH':'CONTRAST NORMAL');}
},'','F'+(i+1)));
function setBank(l){
  S.bank=l; ['A','B','C','D'].forEach(k=>{setOn('bankL'+k,k===l);setOn('bankR'+k,k===l);});
  toast('PAD BANK '+l); renderLCD();
}
[['A',104],['B',183],['C',262]].forEach(([l,x])=>btn('bankL'+l,x,399,46,30,()=>setBank(l),'','PAD BANK '+l));
[['A',971],['B',1051],['C',1131],['D',1210]].forEach(([l,x])=>btn('bankR'+l,x,359,50,28,()=>setBank(l),'','BANK '+l));
setOn('bankLA',true); setOn('bankRA',true);
btn('edit',104,467,46,30,()=>page('EDIT'),'','EDIT');
btn('sample',183,467,46,30,()=>page('SAMPLE'),'','SAMPLE');
btn('program',262,467,46,30,()=>page('PROGRAM'),'','PROGRAM');
function tog(key,id,label){ S[key]=!S[key]; setOn(id,S[key]); toast(label+(S[key]?' ON':' OFF')); applyFx(); renderLCD(); }
btn('effects',104,531,46,30,()=>{tog('fx','effects','EFFECTS');page('FX');},'','EFFECTS');
btn('eq',183,531,46,30,()=>{tog('eq','eq','EQ');},'','EQ');
btn('eqcomp',262,531,46,30,()=>{tog('comp','eqcomp','EQ COMP');},'','EQ COMP');
btn('shift',108,576,56,20,()=>tog('shift','shift','SHIFT'),'','SHIFT');
btn('mainscreen',395,398,48,28,()=>{S.win=false;setOn('openwindow',false);page('SAMPLE');toast('MAIN SCREEN');},'','MAIN SCREEN');
btn('openwindow',537,398,48,30,()=>{S.win=!S.win;setOn('openwindow',S.win);renderLCD();},'org','OPEN WINDOW');
btn('nr',105,657,52,30,()=>{ if(S.shift){tog('after','nr','AFTER');} else {tog('nr','nr','NOTE REPEAT');} },'','NOTE REPEAT / AFTER');
{
  let taps=[];
  btn('tap',264,657,56,32,()=>{
    const n=performance.now(); if(taps.length&&n-taps[taps.length-1]>2000)taps=[];
    taps.push(n); taps=taps.slice(-5);
    if(taps.length>1){const d=(taps[taps.length-1]-taps[0])/(taps.length-1); S.bpm=Math.round(clamp(60000/d,30,300)*10)/10; toast('TEMPO '+S.bpm.toFixed(1)); renderLCD();}
    else toast('TAP TEMPO...');
  },'','TAP TEMPO');
}
btn('undo',230,746,46,30,()=>{ if(undoSnap){const c=seqs[S.seq];seqs[S.seq]=undoSnap;undoSnap=c;toast('UNDO SEQ');}else toast('NOTHING TO UNDO'); },'','UNDO SEQ');
btn('erase',310,746,46,30,()=>{ undoSnap=seqs[S.seq]; seqs[S.seq]=[]; toast('SEQUENCE ERASED'); },'','ERASE');
btn('fulllevel',761,265,58,40,()=>{S.full=!S.full;setOn('fulllevel',S.full);toast('FULL LEVEL '+(S.full?'ON':'OFF'));},'','FULL LEVEL');
btn('lv16',865,265,58,40,()=>{S.lv16=!S.lv16;setOn('lv16',S.lv16);toast('16 LEVELS '+(S.lv16?'ON  PAD '+pad2(S.sel):'OFF'));},'','16 LEVELS');
btn('nextseq',761,347,58,40,()=>{S.seq=S.seq===1?2:1;undoSnap=null;toast('SEQUENCE '+pad2(S.seq));renderLCD();},'','NEXT SEQ');
btn('trackmute',865,347,58,40,()=>{S.mute=!S.mute;setOn('trackmute',S.mute);toast('TRACK '+(S.mute?'MUTED':'ACTIVE'));renderLCD();},'','TRACK MUTE');

/* cursor */
function moveRow(d){
  if(S.page==='SAMPLE'||S.page==='PROGRAM'){
    let i=S.hl+d, w4=Math.floor((S.sel-1)/4)*4;
    if(i<0){ if(w4>0){w4-=4;i=3;}else i=0; } else if(i>3){ if(w4<12){w4+=4;i=0;}else i=3; }
    S.hl=i; S.sel=w4+i+1;
  }else S.prow=clamp(S.prow+d,0,3);
  renderLCD();
}
function movePad(d){ S.sel=((S.sel-1+d+16)%16)+1; S.hl=(S.sel-1)%4; renderLCD(); }
btn('cup',462,684,50,30,()=>moveRow(-1),'','CURSOR UP');
btn('cdown',462,729,50,34,()=>moveRow(1),'','CURSOR DOWN');
btn('cleft',417,708,38,80,()=>movePad(-1),'','CURSOR LEFT');
btn('cright',506,708,32,80,()=>movePad(1),'','CURSOR RIGHT');

/* locate + transport */
function loc(target){ dispStep=((target%LEN)+LEN)%LEN; step=dispStep; lastStep={s:dispStep,t:ac?ac.currentTime:0}; if(S.playing&&ac)nextT=ac.currentTime+.05; refreshPos(); }
btn('locBar-',230,826,46,28,()=>loc(dispStep-16),'','BAR BACK');
btn('locEv-',312,826,46,28,()=>loc(dispStep-1),'','STEP BACK');
btn('goto',393,826,46,28,()=>{loc(0);toast('GO TO 001: 01.00');},'','GO TO');
btn('step',474,826,46,28,()=>loc(dispStep+1),'','STEP');
btn('locBar+',553,826,46,28,()=>loc(dispStep+16),'','BAR FORWARD');
btn('rec',231,917,56,50,()=>{S.rec=!S.rec;setOn('rec',S.rec);if(!S.rec){S.od=false;setOn('overdub',false);}toast(S.rec?'REC ARMED':'REC OFF');},'red','REC');
btn('overdub',312,917,56,50,()=>{S.od=!S.od;setOn('overdub',S.od);if(S.od&&!S.rec){S.rec=true;setOn('rec',true);}toast('OVER DUB '+(S.od?'ON':'OFF'));},'red','OVER DUB');
btn('stop',393,917,56,50,()=>stop(),'','STOP');
btn('play',474,917,56,50,()=>{start(false);},'','PLAY');
btn('playstart',554,917,56,50,()=>{start(true);},'','PLAY START');

/* ---------- data wheel / knobs / fader ---------- */
function disc(cx,cy,r){
  const d=document.createElement('div'); d.className='disc';
  place(d,cx-r,cy-r,2*r,2*r);
  d.style.backgroundSize=`calc(${W}*var(--p)) calc(1213*var(--p))`;
  d.style.backgroundPosition=`calc(${-(cx-r)}*var(--p)) calc(${-(cy-r)}*var(--p))`;
  stage.appendChild(d); return d;
}
const dWheel=disc(462,532,74), dRec=disc(1028,263,35), dVol=disc(1173,262,35);
function dataTurn(n){
  const k=S.shift?10:1;
  if(S.page==='SAMPLE'||(S.page==='MIX'&&S.prow===3)){S.bpm=Math.round(clamp(S.bpm+n*.1*k,30,300)*10)/10;}
  else if(S.page==='EDIT'){
    const i=S.sel-1;
    if(S.prow===0)padStart[i]=clamp(padStart[i]+n*k,0,padEnd[i]-1);
    else if(S.prow===1)padEnd[i]=clamp(padEnd[i]+n*k,padStart[i]+1,100);
    else if(S.prow===2)padTune[i]=Math.round(clamp(padTune[i]+n*.1*k,-12,12)*10)/10;
    else padLevel[i]=clamp(padLevel[i]+n*k,0,127);
  }else if(S.page==='PROGRAM'){ const i=S.sel-1; padLevel[i]=clamp(padLevel[i]+n*k,0,127); }
  else if(S.page==='MIX'){
    if(S.prow===0)S.rg=clamp(S.rg+n*.01*k,0,1);
    else if(S.prow===1){S.vol=clamp(S.vol+n*.01*k,0,1);setVol();}
    else if(S.prow===2)S.ftune=Math.round(clamp(S.ftune+n*.1*k,-12,12)*10)/10;
  }else{
    if(S.prow===0||S.prow===3){if((n>0)!==S.fx){S.fx=n>0;setOn('effects',S.fx);}}
    else if(S.prow===1){if((n>0)!==S.eq){S.eq=n>0;setOn('eq',S.eq);}}
    else if(S.prow===2){if((n>0)!==S.comp){S.comp=n>0;setOn('eqcomp',S.comp);}}
    applyFx();
  }
  syncKnobs(); renderLCD();
}
{
  const w=mk('data',462,532,190,190,'round','DATA'); let rot=0,acc=0,last=null;
  const ang=e=>{const r=w.getBoundingClientRect();return Math.atan2(e.clientY-(r.top+r.height/2),e.clientX-(r.left+r.width/2))*180/Math.PI;};
  const spin=d=>{rot+=d;dWheel.style.transform=`rotate(${rot}deg)`;};
  bind(w,{
    down:e=>{last=e?ang(e):null;acc=0;},
    move:e=>{ if(last==null)return; const a=ang(e); let d=a-last; if(d>180)d-=360; if(d<-180)d+=360; last=a; spin(d); acc+=d; while(Math.abs(acc)>=9){const s=Math.sign(acc);dataTurn(s);acc-=s*9;} }
  });
  w.addEventListener('wheel',e=>{e.preventDefault();initAudio();const s=-Math.sign(e.deltaY);spin(s*9);dataTurn(s);},{passive:false});
  w.addEventListener('keydown',e=>{ if(e.key==='ArrowUp'||e.key==='ArrowRight'){spin(9);dataTurn(1);} if(e.key==='ArrowDown'||e.key==='ArrowLeft'){spin(-9);dataTurn(-1);} });
}
function setVol(){ if(outG)outG.gain.value=S.vol*1.4; }
function syncKnobs(){
  dRec.style.transform=`rotate(${(S.rg-.5)*270}deg)`;
  dVol.style.transform=`rotate(${(S.vol-.5)*270}deg)`;
  const fm=$('#fmark'); if(fm&&fm.dataset.on){ fm.style.top=`calc(${735+(.5-S.ftune/24)*160-1.5}*var(--p))`; }
}
function knob(id,cx,cy,key,label,after){
  const el=mk(id,cx,cy,84,84,'round',label); let y0=0;
  bind(el,{
    down:e=>{y0=e?e.clientY:0;},
    move:e=>{S[key]=clamp(S[key]+(y0-e.clientY)/170,0,1);y0=e.clientY;after&&after();syncKnobs();toast(label+' '+Math.round(S[key]*100));renderLCD();}
  });
  el.addEventListener('wheel',e=>{e.preventDefault();S[key]=clamp(S[key]-Math.sign(e.deltaY)*.03,0,1);after&&after();syncKnobs();toast(label+' '+Math.round(S[key]*100));},{passive:false});
}
knob('knobRec',1028,263,'rg','REC GAIN');
knob('knobVol',1173,262,'vol','MAIN VOLUME',setVol);
const fm=document.createElement('div'); fm.className='fmark'; fm.id='fmark'; stage.appendChild(fm);
{
  const f=mk('fader',105,818,80,215,'round','NOTE VARIATION SLIDER');
  const setF=e=>{
    const r=stage.getBoundingClientRect(), y=(e.clientY-r.top)/(r.width/W);
    const t=clamp((y-735)/160,0,1); S.ftune=Math.round((.5-t)*24*10)/10;
    fm.dataset.on='1'; fm.style.display='block'; fm.style.top=`calc(${735+t*160-1.5}*var(--p))`;
    toast('TUNE '+tuneStr(S.ftune)); renderLCD();
  };
  bind(f,{down:e=>e&&setF(e),move:setF});
}

/* ---------- keyboard ---------- */
const KEYPAD={z:1,x:2,c:3,v:4,a:5,s:6,d:7,f:8,q:9,w:10,e:11,r:12,'1':13,'2':14,'3':15,'4':16};
addEventListener('keydown',e=>{
  if(e.repeat||e.ctrlKey||e.metaKey||e.altKey)return;
  if(e.target&&e.target.classList&&e.target.classList.contains('hs'))return;
  const k=e.key.toLowerCase();
  if(KEYPAD[k]){const n=KEYPAD[k];initAudio();H['pad'+n].classList.add('down');padDown(n,null,null);}
  else if(e.code==='Space'){e.preventDefault();initAudio();S.playing?stop():start(false);}
  else if(e.key==='Enter'){initAudio();S.rec=!S.rec;setOn('rec',S.rec);toast(S.rec?'REC ARMED':'REC OFF');}
});
addEventListener('keyup',e=>{ const n=KEYPAD[e.key.toLowerCase()]; if(n){H['pad'+n].classList.remove('down');padUp(n);} });

/* ---------- init ---------- */
new ResizeObserver(fit).observe(stage);
bg.addEventListener('load',fit);
fit(); renderLCD(); refreshPos(); syncKnobs(); requestAnimationFrame(drawLCD);
window.__S=S;
})();
</script>
</body>
</html>
