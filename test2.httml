/* ========================================================= */

/* ماسک ناحیه‌ی صفحه‌ی مانیتور و تبلت: هر __…__ را با مقدار قبلی (data:image/png;base64,…) عوض کن */
const MASKS={monitor:'__MASK_MONITOR__',tablet:'__MASK_TABLET__'};
for(const k in MASKS)document.documentElement.style.setProperty('--m-'+k,'url("'+MASKS[k]+'")');

const SIZE = {phone:[390,720],laptop:[1440,888],tablet:[768,1030],monitor:[1600,900]};
function mock(type,i,title){ /* عکس نمونه‌ی بلند (تمام صفحه‌ی سایت) */
  const [w,h0]=SIZE[type],h=Math.round(h0*2.8),hue=(i*37+(type==='laptop'?120:type==='tablet'?240:0))%360;
  let b=`<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl(${hue},75%,58%)"/><stop offset="1" stop-color="hsl(${hue+50},75%,45%)"/></linearGradient></defs><rect width="${w}" height="${h}" fill="#f4f5fa"/><rect width="${w}" height="${h0*.07}" fill="#fff"/><rect x="${w*.05}" y="${h0*.022}" width="${w*.12}" height="${h0*.026}" rx="6" fill="url(#g)"/><rect x="${w*.04}" y="${h0*.1}" width="${w*.92}" height="${h0*.34}" rx="${w*.025}" fill="url(#g)"/><text x="${w/2}" y="${h0*.28}" font-size="${w*.055}" font-family="Tahoma,sans-serif" font-weight="700" fill="#fff" text-anchor="middle">${title}</text>`;
  for(let k=0;k<4;k++){const y=h0*(.48+k*.5);
    b+=[0,1,2].map(c=>`<rect x="${w*(.04+c*.32)}" y="${y}" width="${w*.28}" height="${h0*.2}" rx="${w*.02}" fill="#fff"/><rect x="${w*(.06+c*.32)}" y="${y+h0*.02}" width="${w*.24}" height="${h0*.11}" rx="${w*.015}" fill="hsl(${hue+c*25+k*30},60%,85%)"/>`).join('')
      +`<rect x="${w*.04}" y="${y+h0*.24}" width="${w*.92}" height="${h0*.05}" rx="8" fill="#fff"/><rect x="${w*.04}" y="${y+h0*.31}" width="${w*.6}" height="${h0*.03}" rx="8" fill="#dfe1ee"/>`}
  return 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">${b}</svg>`);
}

/* Hero */
const hero=document.getElementById('hero');let cur=0,timer;
hero.innerHTML=SLIDES.map((u,i)=>`<div class="slide${i?'':' on'}" style="background:#222 url('${u}') center/cover no-repeat"></div>`).join('')+'<div class="dots">'+SLIDES.map((_,i)=>`<button class="${i?'':'on'}" aria-label="اسلاید ${i+1}"></button>`).join('')+'</div>';
const sl=[...hero.querySelectorAll('.slide')],dt=[...hero.querySelectorAll('.dots button')];
function go(n){cur=(n+sl.length)%sl.length;sl.forEach((e,i)=>e.classList.toggle('on',i===cur));dt.forEach((e,i)=>e.classList.toggle('on',i===cur));clearInterval(timer);timer=setInterval(()=>go(cur+1),5000)}
dt.forEach((b,i)=>b.onclick=()=>go(i));go(0);

/* Gallery + Popup */
const DEV={phone:['📱','موبایل'],laptop:['💻','لپ‌تاپ'],monitor:['🖥️','PC'],tablet:['📲','تبلت']};
const FR={laptop:LAPTOP_FRAME,monitor:MONITOR_FRAME,tablet:TABLET_FRAME};
const full=u=>!u?'':/^(https?:|data:|\/)/.test(u)?u:IMG_BASE+u;
for(const t in PROJECTS)PROJECTS[t].forEach(p=>p.row=t);
/* اولویت: LINKS (فقط برای عکس خود ردیف) ← img داخل پروژه ← عکس نمونه */
const srcOf=(p,t,i)=>full(LINKS[t][i]||p.img[t])||(DEMO?mock(t,i,p.title):'');
function bad(im,t,i){im.onerror=null;if(DEMO)im.src=mock(t,i,im.alt)}
function frame(t,s,alt,i){
  const img=`<div class="vp"><img loading="lazy" src="${s}" alt="${alt}" onerror="bad(this,'${t}',${i})"></div>`;
  return t==='phone'?`<div class="phone"><div class="scr">${img}</div></div>`
    :`<div class="${t}"><div class="scr">${img}</div><img class="frm" src="${FR[t]}" alt=""></div>`;
}
for(const t in PROJECTS){
  document.getElementById(t).innerHTML=PROJECTS[t].map((p,i)=>`<div class="item" tabindex="0" role="button" data-cat="${p.cat}" data-t="${t}" data-i="${i}">${frame(t,srcOf(p,t,i),p.title,i)}<div class="cap">${p.title}</div></div>`).join('');
}
document.querySelectorAll('[data-all]').forEach(a=>a.href=ALL_LINKS[a.dataset.all]||'#');

/* اسکرول خودکار عکس بلند داخل فریم: با هاور (دسکتاپ) یا وقتی کارت در دید است (موبایل) */
function play(it,on){const im=it.querySelector('.vp img');if(!im)return;const d=Math.max(0,im.offsetHeight-im.parentElement.clientHeight);
  im.style.transitionDuration=(on?Math.min(18,Math.max(3,d/90)):.7)+'s';im.style.transform=on?`translateY(-${d}px)`:'translateY(0)'}
document.querySelectorAll('.item').forEach(it=>{it.onmouseenter=()=>play(it,true);it.onmouseleave=()=>play(it,false)});
if(matchMedia('(hover:none)').matches){const io=new IntersectionObserver(es=>es.forEach(e=>play(e.target,e.intersectionRatio>.6)),{threshold:[0,.6]});document.querySelectorAll('.item').forEach(it=>io.observe(it))}

const pop=document.getElementById('pop'),stage=document.getElementById('stage'),devs=document.getElementById('devs'),info=document.getElementById('info');
let pc={};
function row(h,v){return `<tr><th>${h}</th><td>${v}</td></tr>`}
function showDev(d){
  const p=PROJECTS[pc.t][pc.i];pc.d=d;
  stage.innerHTML=frame(d,srcOf(p,d,pc.i),p.title,pc.i);
  devs.innerHTML=Object.keys(DEV).filter(k=>srcOf(p,k,pc.i)).map(k=>`<button data-d="${k}" class="${k===d?'on':''}"><span>${DEV[k][0]}</span>${DEV[k][1]}</button>`).join('');
  const tags=a=>a.map(x=>`<span class="tag">${x}</span>`).join('');
  info.innerHTML=`<h2>${p.title}</h2><table class="tbl">`
    +row('مشخصات سایت',tags(p.features))
    +row('مناسب شغل‌های',tags(p.jobs))
    +row('پشتیبانی سئو',p.seo?'<span class="ok">✔ دارد</span>':'<span class="no">✘ ندارد</span>')
    +row('سطح سایت',Object.keys(LEVELS).map(k=>`<span class="lv${p.level===k?' on':''}">${p.level===k?'☑':'☐'} ${LEVELS[k]}</span>`).join(''))
    +row('قیمت طراحی و تحویل',p.price)
    +row('پشتیبانی ماهانه',p.monthly)
    +row('پروژه سالانه',p.yearly)
    +`</table><a class="call" href="tel:${CALL}">📞 تماس: ${CALL}</a>`;
}
function openPop(t,i){pc={t,i};showDev(t);pop.classList.add('open');pop.setAttribute('aria-hidden','false');document.body.style.overflow='hidden'}
function closePop(){pop.classList.remove('open');pop.setAttribute('aria-hidden','true');document.body.style.overflow=''}
document.addEventListener('click',e=>{const it=e.target.closest('.item');if(it)openPop(it.dataset.t,+it.dataset.i)});
document.addEventListener('keydown',e=>{
  if(e.key==='Escape')closePop();
  if(e.key==='Enter'&&e.target.classList&&e.target.classList.contains('item'))openPop(e.target.dataset.t,+e.target.dataset.i);
});
devs.onclick=e=>{const b=e.target.closest('button');if(b)showDev(b.dataset.d)};
pop.onclick=e=>{if(e.target===pop)closePop()};
document.getElementById('popx').onclick=closePop;

/* Filter */
const chips=document.getElementById('chips'),emptyMsg=document.getElementById('empty');
chips.innerHTML=`<button class="on" data-c="all" style="--c:#5b4bdb"><i>✨</i>همه</button>`
  +Object.entries(CATS).map(([k,[l,e,c]])=>`<button data-c="${k}" style="--c:${c}"><i>${e}</i>${l}</button>`).join('');
chips.onclick=e=>{const b=e.target.closest('button');if(!b)return;
  chips.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));
  let n=0;
  document.querySelectorAll('.item').forEach(it=>{
    const hide=b.dataset.c!=='all'&&it.dataset.cat!==b.dataset.c;
    it.classList.toggle('hide',hide);if(!hide)n++;
  });
  emptyMsg.style.display=n?'none':'block';
  document.querySelectorAll('.track').forEach(t=>t.scrollTo({left:0}));};

/* Arrows (RTL-safe) */
document.querySelectorAll('.arrows button').forEach(b=>b.onclick=()=>{
  const t=document.getElementById(b.dataset.t);
  t.scrollBy({left:-Number(b.dataset.d)*t.clientWidth*.7,behavior:'smooth'});
});
</script>
</body>
</html>
